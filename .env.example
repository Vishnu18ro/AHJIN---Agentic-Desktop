AHJIN_ENV=development
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Max output tokens for model generation fallback. ModelLimits in ModelCatalog take precedence.
NVIDIA_MAX_TOKENS=4096
# HTTP client timeout in seconds for NVIDIA API requests.
NVIDIA_TIMEOUT_SECONDS=90.0

# OpenRouter Provider
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90.0
